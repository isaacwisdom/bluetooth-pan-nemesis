[nemesis]
version=1.1
id=bluetooth.pan
name=Bluetooth PAN
type=application,service
package-version=3.0.0
short-desc=Connects the head unit through a phone's Bluetooth hotspot.
detailed-desc=State-driven Bluetooth PAN connection control with live status and guarded recovery.
os=NEEV23.USA.*,OSNPE23.USA.*
models=any
depends=!iphone.bluetooth.pan
postinstall=scripts/postinstall.sh
preuninstall=scripts/preuninstall.sh

[app.0]
kind=apk
path=app/BluetoothPan.apk
package=org.egmp.bluetoothpan
component=org.egmp.bluetoothpan/org.egmp.bluetoothpan.MainActivity

[service.0]
name=pan-supervisor
kind=sh
path=svc/pan-control.sh
uid=root
mode=restart
